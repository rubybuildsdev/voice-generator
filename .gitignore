# ==============================================================================
# AI Faceless Video Production Engine - Root .gitignore
# Single Source of Truth for the Entire Project
# ==============================================================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
*.env.local

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- Frontend (ui/) ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Vite build artifacts
ui/dist/
dist/
dist-ssr/
*.local

# Linter caches
.eslintcache
.stylelintcache
.oxlintcache

# --- Generated Pipeline Outputs (output/) ---
# Audio binaries are large and generated on demand
output/audio/*
!output/audio/.gitkeep

# Generated transcripts
output/transcripts/*
!output/transcripts/.gitkeep

# Rendered video outputs
out/
render/
*.mp4

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
*.temp
