# Google Gemini API Key (wajib)
GEMINI_API_KEY=your_gemini_api_key_here

# Override Model (opsional — sesuaikan dengan akses model Gemini akun Anda)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TEXT_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# Keamanan CORS (pisahkan dengan koma jika lebih dari satu origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Konfigurasi Server
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=5173
LOG_LEVEL=INFO
